# AUTH
SALT=10
SECRET="manager-api-secret"
JWT_EXPIRES_IN=86400
JWT_ISSUER=manager-api
JWT_AUDIENCE=manager-api-clients

# CORS
CORS_ORIGINS=http://localhost:3000